# Online Environment Configuration (all non-government roles)
# Copy to .env before running: cp .env.online .env

GOVERNMENT_MODE=false
AI_PROVIDER=cloud
EXTERNAL_API_ENABLED=true

# HMAC audit key — CHANGE THIS before production deployment
AUDIT_HMAC_KEY=online-hmac-key-change-before-production

# Optional cloud AI keys (leave blank to use extractive/offline mode)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# YOUTUBE_API_KEY=AIza...

# Session settings
RETENTION_HOURS=24
MAX_UPLOAD_MB=50
MAX_UPLOAD_PAGES=300
