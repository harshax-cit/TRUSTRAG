# Government Offline Environment Configuration
# Copy to .env before running: cp .env.government .env

GOVERNMENT_MODE=offline
AI_PROVIDER=local
EXTERNAL_API_ENABLED=false

# Local SQLite database (default path; change if needed)
DATABASE_URL=sqlite:///data/government.db

# HMAC audit key — CHANGE THIS before production deployment
AUDIT_HMAC_KEY=gov-secure-hmac-key-change-before-production

# Government PDF storage
# PDFs are stored locally; this variable is informational
GOV_PDF_DIR=data/gov_pdfs
GOV_INDEX_DIR=data/gov_index

# DO NOT set any of these in government mode — they are blocked anyway
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# YOUTUBE_API_KEY=

# Retention for session uploads (student study mode disabled in gov mode)
RETENTION_HOURS=24
MAX_UPLOAD_MB=50
MAX_UPLOAD_PAGES=300
