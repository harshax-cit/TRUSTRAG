# ==============================================================================
# TraceRAG — 100% Offline Secure Environment Configuration
# ==============================================================================

# Air-gapped deployment mode (offline enforced across all roles)
GOVERNMENT_MODE=offline
AI_PROVIDER=local
EXTERNAL_API_ENABLED=false

# Local Ollama Configuration (Default localhost)
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_VISION_MODEL=llava:latest

# Local Database & Storage Paths
DATABASE_URL=sqlite:///data/government.db
INDEX_DIR=data/index
PDF_DIR=data/raw/pdfs
RETENTION_HOURS=24
MAX_UPLOAD_MB=50
MAX_UPLOAD_PAGES=300

# Security (HMAC Secret Key for audit log integrity)
# Generate a strong key for production: openssl rand -hex 32
HMAC_SECRET_KEY=local-offline-tracerag-hmac-secret-v2
